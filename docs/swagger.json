                    },
                    {
                        "type": "string",
                        "example": "\"2026-02-23\"",
                        "description": "Начало недели в формате YYYY-MM-DD",
                        "name": "date",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/event.Event"
                            }
                        }
                    },
                    "400": {
                        "description": "Сообщение об ошибке",
                        "schema": {
                            "type": "object",
